# Copy this file to .env and edit. Paths may be absolute or relative to this folder.
# Leave a line out (or empty) to use the default.

# Songs (audio + lyrics + timings) and saved performances. Put this on a backed-up drive.
# Default: data
SINGALONG_DATA_DIR=data

# Generated PowerPoint decks and MP4 videos (can be regenerated, so backing up is optional).
# Default: exports
SINGALONG_EXPORTS_DIR=exports

# Windows example (use forward slashes or single backslashes, no quotes needed):
# SINGALONG_DATA_DIR=D:/OneDrive/SingAlong/data
# SINGALONG_EXPORTS_DIR=D:/OneDrive/SingAlong/exports

# Google AI Studio (Gemini) API key, used by the studio's "automatic timing" (AI) button.
# Create one at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
